# ---------------------------------------------------------------
# Abiball 2027 – Ticketportal
# Kopieren nach .env.local und ausfüllen. Niemals committen!
# ---------------------------------------------------------------

# Öffentliche Adresse der Seite (ohne Slash am Ende)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe – zunächst Testmodus (sk_test_…)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Resend
RESEND_API_KEY=re_
MAIL_FROM="Abiball 2027 <tickets@deine-domain.de>"
MAIL_REPLY_TO=

# Admin-Bereich
ADMIN_PASSWORD=
# mind. 32 Zeichen, z. B.: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Apple Wallet (optional – ohne diese Werte gibt es keine .pkpass-Dateien)
APPLE_PASS_TYPE_ID=pass.de.deine-domain.abiball2027
APPLE_TEAM_ID=
# base64 der PEM-Dateien: base64 -i datei.pem | tr -d '\n'
APPLE_WWDR_CERT_BASE64=
APPLE_SIGNER_CERT_BASE64=
APPLE_SIGNER_KEY_BASE64=
APPLE_SIGNER_KEY_PASSPHRASE=

# Google Wallet (optional – ohne diese Werte gibt es keinen Google-Wallet-Link)
GOOGLE_WALLET_ISSUER_ID=
# base64 der Service-Account-JSON-Datei: base64 -i key.json | tr -d '\n'
GOOGLE_WALLET_SERVICE_ACCOUNT_BASE64=
GOOGLE_WALLET_CLASS_SUFFIX=abiball2027
